#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    chosen { zmk,physical-layout = &physical_layout_imprint_number_row_full_bottom_row; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC        &kp LC(X)           &kp LC(V)           &kp LC(C)            &kp LG(V)           &kp LC(F)                             &kp NUMBER_6        &kp N7              &kp N8               &kp N9                       &kp N0                 &kp MINUS
&kp TAB        &mt LS(NUMBER_1) B  &mt LS(NUMBER_2) L  &mt LS(NUMBER_3) D   &mt LS(NUMBER_4) C  &mt LS(NUMBER_5) V                    &mt RS(NUMBER_6) J  &mt RS(NUMBER_7) F  &mt RS(NUMBER_8) O   &mt RS(NUMBER_9) U           &mt RS(N0) COMMA       &kp BSLH
&kp LC(LS(S))  &mt LEFT_GUI N      &mt LEFT_ALT R      &mt LEFT_CONTROL T   &mt LEFT_SHIFT S    &mt MINUS G                           &mt EQUAL Y         &mt RIGHT_SHIFT H   &mt RIGHT_CONTROL A  &mt RIGHT_ALT E              &mt RIGHT_GUI I        &mt RS(SLASH) SLASH
&kp LSHFT      &kp X               &kp Q               &kp M                &kp W               &kp Z                                 &kp K               &kp P               &mt RS(SQT) SQT      &mt RS(SEMICOLON) SEMICOLON  &mt RS(PERIOD) PERIOD  &kp RSHFT
&kp CAPSLOCK   &kp LS(LC(W))       &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(BACKSPACE)                                                             &trans              &kp LBKT             &kp RBKT                     &trans                 &trans
                                                                            &mo 3               &mkp LCLK           &mkp RCLK         &mkp RCLK           &mkp LCLK           &mo 3
                                                                            &kp BACKSPACE       &lt 1 SPACE         &lt 2 KP_ENTER    &lt 2 KP_ENTER      &lt 1 SPACE         &kp BACKSPACE
            >;
        };

        Numpad_Nav_Layer {
            bindings = <
&trans  &trans            &trans        &trans  &trans        &trans                  &trans        &trans        &trans        &trans        &trans            &trans
&trans  &kp LS(NUMBER_5)  &kp NUMBER_9  &kp N8  &kp NUMBER_7  &trans                  &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp LS(NUMBER_5)  &trans
&trans  &kp MINUS         &kp NUMBER_6  &kp N5  &kp NUMBER_4  &trans                  &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS         &trans
&trans  &kp PERIOD        &kp NUMBER_3  &kp N2  &kp NUMBER_1  &kp NUMBER_0            &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD        &trans
&trans  &trans            &trans        &kp N0  &trans                                              &trans        &trans        &trans        &trans            &trans
                                                &trans        &trans        &trans    &trans        &trans        &trans
                                                &trans        &trans        &trans    &trans        &trans        &trans
            >;
        };

        Keyboard_Control_Layer {
            bindings = <
&trans  &trans    &trans                       &trans          &trans            &trans             &trans    &trans                             &trans                               &trans               &trans   &trans
&trans  &trans    &trans                       &kp UP_ARROW    &trans            &trans             &trans    &trans                             &kp UP_ARROW                         &trans               &trans   &trans
&trans  &kp HOME  &kp LEFT_ARROW               &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp END            &kp HOME  &kp LEFT_ARROW                     &kp DOWN_ARROW                       &kp RIGHT_ARROW      &kp END  &trans
&trans  &trans    &mt LS(BACKSLASH) BACKSLASH  &kp LESS_THAN   &kp GREATER_THAN  &trans             &trans    &mt LS(LEFT_BRACKET) LEFT_BRACKET  &mt LS(RIGHT_BRACKET) RIGHT_BRACKET  &mt LS(GRAVE) GRAVE  &trans   &trans
&trans  &trans    &trans                       &trans          &trans                                         &trans                             &trans                               &trans               &trans   &trans
                                                               &trans            &trans   &trans    &trans    &trans                             &trans
                                                               &trans            &trans   &trans    &trans    &trans                             &trans
            >;
        };

        Auto_Mouse_Layer {
            bindings = <
&trans               &trans                 &trans                       &trans               &trans              &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&kp BSLH             &mt RS(N0) COMMA       &mt RS(NUMBER_9) U           &mt RS(NUMBER_8) O   &mt RS(NUMBER_7) F  &mt RS(NUMBER_6) J            &trans  &trans  &trans  &trans  &trans  &trans
&mt RS(SLASH) SLASH  &mt RIGHT_GUI I        &mt RIGHT_ALT E              &mt RIGHT_CONTROL A  &mt RIGHT_SHIFT H   &mt EQUAL Y                   &trans  &trans  &trans  &trans  &trans  &trans
&kp RSHFT            &mt RS(PERIOD) PERIOD  &mt RS(SEMICOLON) SEMICOLON  &mt RS(SQT) SQT      &kp P               &kp K                         &trans  &trans  &trans  &trans  &trans  &trans
&trans               &kp DOWN_ARROW         &kp UP_ARROW                 &kp LEFT_ARROW       &kp RIGHT_ARROW                                           &trans  &trans  &trans  &trans  &trans
                                                                                              &trans              &trans              &trans    &trans  &trans  &trans
                                                                                              &trans              &trans              &trans    &trans  &trans  &trans
            >;
        };

        factory_test {
            bindings = <
&kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7            &kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3
&kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9            &kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N1            &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7
&kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3            &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9
&kp N0  &kp N1  &kp N2  &kp N3  &kp N4                            &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                                &kp N1  &kp N2  &kp N3    &kp N4  &kp N5  &kp N6
                                &kp N7  &kp N8  &kp N9    &kp N0  &kp N1  &kp N2
            >;
        };
    };
};


&trackball_central_listener {
    input-processors = <&zip_xy_scaler 1 1>;

    scroller {
        layers = <3>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 10>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
        process-next;
    };
};

&trackball_central_listener {
    input-processors = <&zip_xy_scaler 1 1>;

    scroller {
        layers = <3>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 10>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
        process-next;
    };
};
